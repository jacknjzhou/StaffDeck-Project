# StaffDeck server deployment environment.
# Copy to `.env` and set strong values before running `docker compose up`.

# PostgreSQL password (used by postgres + api/worker/connector DATABASE_URL)
STAFFDECK_PG_PASSWORD=change-me-strong

# JWT signing secret — must be long and random in production
STAFFDECK_APP_SECRET=change-me-long-random

# Deployment environment: production enforces APP_SECRET strength at startup.
STAFFDECK_ENVIRONMENT=production
# 生成：python -c "import secrets; print(secrets.token_urlsafe(48))"
STAFFDECK_BOOTSTRAP_ADMIN_PASSWORD=
