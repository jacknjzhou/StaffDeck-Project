# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.pytest_cache/
.ruff_cache/
.npm-cache/

# Local runtime state (SQLite desktop mode)
backend/*.db
# SQLite sidecars: -wal/-shm appear while the DB is open, and repair/backup
# copies are local artefacts. None of them should ever be committed.
backend/*.db-*
backend/*.db.*
backend/*.db.*.lock

# Frontend
node_modules/
frontend-enterprise/dist/

# Docker / deployment secrets
packaging/docker/.env

# Agent/tooling scratch
.superpowers/
.workbuddy/

# Local git worktrees
.worktrees/

# Database backups produced by scripts/backup_db.sh
backups/

# local tooling caches and runtime artifacts
frontend-enterprise/.npm-cache/
backend/.runtime_venv/
frontend-enterprise/tsconfig.tsbuildinfo
